{
  "name": "n8n-nodes-ordigovernance",
  "version": "0.1.0",
  "description": "n8n community nodes for the ordigovernance governance gateway: governed runs, tasks, tools, HITL and composites with a complete audit trail",
  "license": "MIT",
  "homepage": "https://github.com/orditect/n8n-nodes-ordigovernance#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orditect/n8n-nodes-ordigovernance.git"
  },
  "bugs": {
    "url": "https://github.com/orditect/n8n-nodes-ordigovernance/issues"
  },
  "keywords": [
    "n8n-community-node-package"
  ],
  "author": {
    "name": "orditect",
    "url": "https://github.com/orditect"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials --ext .ts",
    "lintfix": "eslint nodes credentials --ext .ts --fix",
    "prepublishOnly": "npm run build && npm run lint",
    "test": "vitest run",
    "release": "np --no-publish --no-release-draft"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/OrdigovernanceApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/OrdigovernanceRun/OrdigovernanceRun.node.js",
      "dist/nodes/OrdigovernanceTool/OrdigovernanceTool.node.js",
      "dist/nodes/OrdigovernanceTask/OrdigovernanceTask.node.js",
      "dist/nodes/OrdigovernanceApproval/OrdigovernanceApproval.node.js",
      "dist/nodes/OrdigovernanceComposite/OrdigovernanceComposite.node.js",
      "dist/nodes/OrdigovernanceEvidence/OrdigovernanceEvidence.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "eslint": "^8.57.1",
    "gulp": "^5.0.0",
    "n8n-workflow": "^1.82.0",
    "np": "^10.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}